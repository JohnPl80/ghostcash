# Copy this file to `.env` and fill in the values you need.
# Never commit the real `.env` file (it is already in .gitignore).
#
# Only AI_API_KEY is needed to get topic/content generation running (Phase 2+).
# BUFFER_API_KEY and GUMROAD_API_KEY are only needed once you reach the
# publishing (Phase 6) and product (Phase 8) phases respectively.

# --- AI provider (see CLAUDE.md section 9-10) ---
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_MAX_REQUESTS_PER_RUN=20
AI_TEMPERATURE=0.7

# --- Publishing (Buffer) ---
BUFFER_API_KEY=

# --- Media hosting for video attachments (needed only for local/manual
# `ghostcash publish` runs with publishing.media_host=github_release;
# GitHub Actions provides this automatically, no setup needed there) ---
GITHUB_TOKEN=

# --- Digital product store (Gumroad). Generate at
# https://app.gumroad.com/settings/advanced under "Applications":
# create an application (redirect URI "localhost" is fine), then click
# "Generate access token" - that token is this value. ---
GUMROAD_API_KEY=

# --- Notifications (email / Discord / Telegram - pick one) ---
NOTIFICATION_PROVIDER=
NOTIFICATION_TOKEN=

# --- Database ---
DATABASE_PATH=data/ghostcash.db

# --- Optional: override which config file is loaded ---
# GHOSTCASH_CONFIG_PATH=config/config.yaml
